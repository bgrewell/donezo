# donezod production unit template (system-level).
#
# Assumes the release binary (built with `make release-build`, web UI
# embedded) installed at /usr/local/bin/donezod. Setup:
#
#   sudo useradd --system --home-dir /var/lib/donezo --shell /usr/sbin/nologin donezo
#   sudo install -d -o donezo -g donezo -m 0750 /var/lib/donezo
#   sudo cp donezod.service.example /etc/systemd/system/donezod.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now donezod
#
# Optional environment overrides (DONEZOD_PORT, DONEZOD_SEED, ...) go in
# /etc/donezo/donezod.env; the leading "-" below makes the file optional.
#
# --trust-proxy assumes a reverse proxy (TLS-terminating) directly in
# front of donezod. It also binds donezod to 127.0.0.1 by default, so the
# port is not exposed to the network and a direct connection cannot bypass
# the proxy (or forge the forwarded headers). Point the proxy at
# 127.0.0.1:8787. Remove --trust-proxy if clients connect to :8787
# directly — with no proxy the forwarded headers are attacker-controlled,
# and donezod then binds all interfaces. If the proxy runs on a different
# host, keep --trust-proxy, add --bind <addr> to listen off-loopback, and
# --trusted-proxies <cidr> so only that proxy's forwarded headers count.

[Unit]
Description=donezod — donezo backend API server with embedded web UI
After=network.target

[Service]
Type=simple
User=donezo
Group=donezo
ExecStart=/usr/local/bin/donezod --data-dir /var/lib/donezo --port 8787 --trust-proxy
EnvironmentFile=-/etc/donezo/donezod.env
Restart=always
RestartSec=2

# Hardening: the service needs nothing beyond its data dir and the port.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/donezo
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
